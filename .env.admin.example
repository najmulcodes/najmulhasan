# --- required ---
ADMIN_PASSWORD=             # 16+ chars, random (openssl rand -base64 24)
ADMIN_SESSION_SECRET=       # 32+ chars (openssl rand -base64 48)
GITHUB_TOKEN=               # fine-grained PAT: this repo only, Contents: Read and write
GITHUB_REPO=owner/repo      # e.g. najmulcodes/najmulhasan
GITHUB_BRANCH=main
# --- optional ---
SITE_URL=https://najmulhasan.navicore.co
DEVTO_API_KEY=              # dev.to > Settings > Extensions > API keys
INDEXNOW_KEY=               # any 8-128 chars [a-zA-Z0-9-], e.g. openssl rand -hex 16
GSC_PROPERTY=sc-domain:navicore.co
UPSTASH_REDIS_REST_URL=     # login throttling (recommended)
UPSTASH_REDIS_REST_TOKEN=
